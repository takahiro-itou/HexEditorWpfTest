
<Window x:Class="WpfHexEditor.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localview="clr-namespace:WpfHexEditor.Views"
    Title="WPF Hex Editor"
    Height="450" Width="600"
>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <local:HexRenderElement
        x:Name="HexEditor"
        Grid.Column0Background="White"
    />

    <ScrollBar x:Name="VerticalScroll"
        Grid.Column="1"
        Orientation="Vertical"
        Scroll="VerticalScroll_Scroll"
    />
  </Grid>

</Window>
