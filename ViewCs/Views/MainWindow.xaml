
<Window x:Class="ViewCs.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewCs"
    Title="MainWindow"
    Height="512" Width="440"
>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool2Visible" />
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="Run _Command"
          Click="mnuRunCommand_Click" />
        />
        <MenuItem Header="Clear Text"
            Command="{Binding ClearTextCommand}"
        />
      </MenuItem>
    </Menu>

    <StackPanel Orientation="Vertical">
      <Image x:Name="picView" Stretch="None" />
    </StackPanel>
  </DockPanel>

</Window>
